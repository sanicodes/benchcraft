<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/background_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <ImageView
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/background_icon_badge"
            android:importantForAccessibility="no"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_user"
            android:tint="@color/brand" />

        <TextView
            style="@style/MojoLauncher.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_heavy"
            android:layout_marginBottom="@dimen/padding_large"
            android:text="@string/main_add_account" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="@string/auth_select_microsoft" />

        <Button
            android:id="@+id/button_elyby_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/padding_moderate"
            android:text="@string/auth_select_elyby"
            android:textSize="@dimen/_12ssp" />

        <Button
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/padding_moderate"
            android:text="@string/auth_select_local"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>
</FrameLayout>
