<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_instance_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_card"
    android:orientation="vertical"
    android:padding="@dimen/padding_moderate">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/_56sdp"
            android:layout_weight="1"
            android:background="@drawable/button_borderless"
            android:drawableEnd="@drawable/spinner_arrow_down"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text_contrast"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_16sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_44sdp" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            style="@style/MojoLauncher.IconButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/padding_small"
            android:contentDescription="@string/dashboard_edit_instance"
            android:padding="@dimen/_11sdp"
            android:src="@drawable/ic_px_edit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginTop="@dimen/padding_small"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/padding_medium"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dashboard_instance_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_medium"
            android:background="@drawable/background_badge"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:textColor="@color/brand"
            android:textSize="@dimen/_9ssp"
            tools:text="Fabric · Minecraft 1.21.1" />

        <TextView
            android:id="@+id/dashboard_instance_renderer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_chip"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:textColor="@color/text_base"
            android:textSize="@dimen/_9ssp"
            tools:text="Renderer: LTW" />
    </LinearLayout>
</LinearLayout>
