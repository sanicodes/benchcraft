<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/padding_medium"
    android:background="@drawable/background_line"
    android:paddingHorizontal="@dimen/padding_moderate"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/mod_thumbnail_imageview"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/mod_title_textview"
            style="@style/TextAppearance.AppCompat.Body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_moderate"
            android:layout_marginEnd="@dimen/padding_medium"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
            app:layout_constraintEnd_toStartOf="@+id/mod_manager_enable_switch"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sodium" />

        <TextView
            android:id="@+id/mod_version_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintEnd_toEndOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@id/mod_title_textview"
            tools:text="0.6.0+mc1.21.1" />

        <TextView
            android:id="@+id/mod_body_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintEnd_toEndOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@id/mod_version_textview"
            tools:text="The fastest and most compatible rendering optimization mod for Minecraft." />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/mod_manager_enable_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ViewStub
        android:id="@+id/mod_limited_state_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout="@layout/view_mod_modmanager_extended" />

</LinearLayout>
