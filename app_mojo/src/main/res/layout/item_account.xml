<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="@dimen/_44sdp"
    android:layout_width="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <fr.spse.extended_view.ExtendedTextView
        android:id="@+id/account_item"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/text_contrast"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:singleLine="true"
        android:drawablePadding="@dimen/_10sdp"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"
        app:drawableStartSize="@dimen/_26sdp"
        app:drawableEndSize="@dimen/_16sdp"
        tools:text="HELLO THERE"
        tools:drawableStart="@mipmap/ic_launcher"
        tools:ignore="RtlSymmetry" />
    <!-- Fun fact, if I put an Image button, the spinner fails to put an onclick listener on the extended view -->
    <ImageView
        android:id="@+id/delete_account_button"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginEnd="@dimen/padding_medium"
        android:background="@drawable/button_icon"
        android:contentDescription="@string/global_delete"
        android:src="@drawable/ic_px_trash"
        android:padding="@dimen/_9sdp"
        app:tint="@color/danger"
        />
</LinearLayout>
